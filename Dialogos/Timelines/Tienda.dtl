join GerenteTienda right
GerenteTienda: Bienvenido
label AbreTienda
GerenteTienda: Que desea comprar?
- Cuchillo | [if {Global.armas}.has("pistola") and !{Global.armas}.has("cuchillo")]
	if {Global.dinero} == 375.0:
		do Global.comprar("cuchillo")
	else:
		GerenteTienda: Pinche pobre

- Pistola | [if {Global.armas}.has("cuchillo") and !{Global.armas}.has("pistola")]
	if {Global.dinero} == 375.0:
		do Global.comprar("pistola")
	else:
		GerenteTienda: Pinche pobre

- [img]res://Recursos/Sprite/Armas/Pisstolita.png[/img]  Escopeta [img]res://Recursos/Sprite/Monedas/Moneda_5.png[/img] 375 | [if !{Global.armas}.has("escopeta")]
	if {Global.dinero} == 375.0:
		GerenteTienda: Muchas gracias por su compra
		do Global.comprar("escopeta")
	else:
		GerenteTienda: Pinche pobre

- Curacion | [if  !{Global.habilidades}.has("curacion")]
	if {Global.dinero} == 375.0:
		GerenteTienda: Muchas gracias por su compra
	else:
		GerenteTienda: Pinche pobre

- Dash | [if !{Global.habilidades}.has("dash")]

- Granada | [if !{Global.habilidades}.has("granada")]

- Nada (salir)
	GerenteTienda: Hasta luego
	[wait time="1.0"]
	do cambio_escena.cambio_escena_str("res://Escenas/Cosas/mapa.tscn")
	[end_timeline]

jump AbreTienda